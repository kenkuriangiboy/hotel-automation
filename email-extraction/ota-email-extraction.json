    {
      "parameters": {
        "jsCode": "const subject = $json.subject;\n\n// Extract the booking ID that follows patterns like:\n// \"Cancellation received for Booking ID : GH70132277316572\"\n// \"Agoda Booking ID 1993445358 - CANCELLED...\"\nconst match = subject.match(/(?:Booking ID\\s*[:\\s]\\s*)([A-Za-z0-9]+)/i);\nconst bookingId = match ? match[1] : null;\n\nlet platform = \"Unknown\";\nif (subject.includes(\"MakeMyTrip\")) platform = \"MakeMyTrip\";\nelse if (subject.includes(\"GoIbibo\") || subject.includes(\"Goibibo\")) platform = \"Goibibo\";\nelse if (subject.toLowerCase().includes(\"agoda\")) platform = \"Agoda\";\n\nreturn [{ json: { booking_id: bookingId, platform: platform } }];"
      },
