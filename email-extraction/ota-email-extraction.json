      "parameters": {
        "jsCode": "let raw = $input.item.json.output;\n\n// Strip markdown code fences if present\nraw = raw.replace(/```json\\s*/g, '').replace(/```\\s*/g, '').trim();\n\nconst parsed = JSON.parse(raw);\nreturn [{ json: parsed }];"
